{
  "name": "savana-edit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first desktop video editor foundation",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5174 && npm run electron\"",
    "build": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && vite build",
    "test": "node --test tests/*.test.cjs",
    "electron": "node electron/launch.cjs",
    "pack:win": "npm run build && electron-builder --config electron-builder.cjs --win --dir",
    "dist:win": "npm run build && electron-builder --config electron-builder.cjs --win"
  },
  "dependencies": {
    "@remotion/bundler": "^4.0.512",
    "@remotion/player": "^4.0.512",
    "@remotion/renderer": "^4.0.512",
    "dotenv": "^17.4.2",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.512",
    "zod": "^4.4.3",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  }
}
